{
	"schemaVersion": 1,
	"id": "seasonal-visuals",
	"version": "${version}",
	"name": "Seasonal Visuals",
	"description": "Client-side mod to add seasonal visual effects",
	"authors": [
		"ztrehagem"
	],
	"contact": {
		"homepage": "https://github.com/ztrehagem/seasonal-visuals/",
		"sources": "https://github.com/ztrehagem/seasonal-visuals/"
	},
	"license": "Mozilla Public License 2.0",
	"icon": "assets/seasonal-visuals/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.ztrehagem.seasonalvisuals.client.SeasonalVisualsClient"
		]
	},
	"mixins": [
		"seasonal-visuals.mixins.json",
		{
			"config": "seasonal-visuals.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
